{
  "name": "agentic-repurpose",
  "version": "0.1.0",
  "description": "Local content repurposing for X, LinkedIn, Instagram, and Reddit with six text templates, a TypeScript SDK, CLI, and MCP server.",
  "keywords": [
    "content-repurposing",
    "social-media",
    "X",
    "LinkedIn",
    "Instagram",
    "Reddit",
    "text-templates",
    "TypeScript",
    "Node.js",
    "cli",
    "mcp",
    "carousel",
    "video-script"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-repurpose.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-repurpose",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-repurpose": "./dist/cli.js",
    "agentic-repurpose-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
